# Supabase project settings (required)
# Use the service_role key, NOT the anon key — writes/deletes must bypass RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Refresh / retention (defaults shown)
REFRESH_INTERVAL_HOURS=6
RETENTION_HOURS=48
HN_TOP_N=60
ARXIV_MAX_RESULTS=10
USER_AGENT=clawrlos-ops-mcp/0.1

# Optional: raises the GitHub API anonymous rate limit (60/hr -> 5000/hr)
# used by get_repo_quickstart
GITHUB_TOKEN=

LOG_LEVEL=INFO
